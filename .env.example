# Data source: flex (recommended), json, or client_portal
IBKR_SOURCE=flex

# JSON source (local path or HTTPS URL). Required when IBKR_SOURCE=json.
# Live runs never fall back to the bundled sample.
IBKR_JSON_SOURCE=

# IBKR Flex Web Service. On macOS the token can instead be stored in Keychain
# under service ibkr-zectrix-dashboard/ibkr-flex-token.
IBKR_FLEX_QUERY_ID=
# Optional second query configured for Last Business Day. It supplies true
# account and per-position daily P&L without confusing it with 30-day P&L.
IBKR_FLEX_DAILY_QUERY_ID=
IBKR_FLEX_TOKEN=
IBKR_FLEX_BASE_URL=https://ndcdyn.interactivebrokers.com/AccountManagement/FlexWebService
IBKR_FLEX_PERIOD_DAYS=30
IBKR_FLEX_POLL_ATTEMPTS=8

# IBKR Client Portal Gateway (requires daily interactive authentication)
IBKR_CP_BASE_URL=https://localhost:5000/v1/api
IBKR_CP_ACCOUNT_ID=
IBKR_CP_VERIFY_TLS=false

# ZECTRIX Open API. On macOS the API key can instead be stored in Keychain
# under service ibkr-zectrix-dashboard/zectrix-api-key.
ZECTRIX_API_BASE_URL=https://cloud.zectrix.com
ZECTRIX_API_KEY=
# Optional when exactly one ZECTRIX device is bound to the account.
ZECTRIX_DEVICE_ID=
ZECTRIX_PAGE_ID=1

# Dashboard behavior
DASHBOARD_CURRENCY=USD
DASHBOARD_TIMEZONE=Asia/Shanghai
DASHBOARD_FONT_PATH=
DASHBOARD_STATE_PATH=state/history.json
DASHBOARD_OUTPUT_PATH=output/ibkr-dashboard.png
DASHBOARD_MAX_POSITIONS=4
DASHBOARD_DEDUPE_STATE_PATH=state/last-push.json

# Retry transient image-delivery failures. Optional healthchecks.io-compatible
# URL receives a success ping, or /fail when a run fails.
ZECTRIX_PUSH_ATTEMPTS=3
HEALTHCHECK_URL=
