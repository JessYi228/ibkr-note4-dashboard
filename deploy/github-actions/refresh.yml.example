name: Refresh NOTE4 (private deployment)

on:
  workflow_dispatch:
    inputs:
      no_push:
        description: Fetch and render without contacting ZECTRIX
        required: true
        default: true
        type: boolean
  # Enable only after one successful no-push run, image review, one explicitly
  # authorized live push, and confirmation of the physical NOTE4 refresh.
  # schedule:
  #   - cron: "17 10 * * 1-5"

permissions:
  contents: read

concurrency:
  group: ibkr-note4-refresh
  cancel-in-progress: false

jobs:
  refresh:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    env:
      IBKR_SOURCE: flex
      IBKR_FLEX_QUERY_ID: ${{ secrets.IBKR_FLEX_QUERY_ID }}
      IBKR_FLEX_DAILY_QUERY_ID: ${{ secrets.IBKR_FLEX_DAILY_QUERY_ID }}
      IBKR_FLEX_TOKEN: ${{ secrets.IBKR_FLEX_TOKEN }}
      IBKR_FLEX_PERIOD_DAYS: "30"
      ZECTRIX_API_KEY: ${{ secrets.ZECTRIX_API_KEY }}
      ZECTRIX_DEVICE_ID: ${{ secrets.ZECTRIX_DEVICE_ID }}
      HEALTHCHECK_URL: ${{ secrets.HEALTHCHECK_URL }}
    steps:
      - name: Check out the reviewed public release
        uses: actions/checkout@v7
        with:
          repository: JessYi228/ibkr-note4-dashboard
          ref: v0.2.0
          path: app
      - uses: actions/setup-python@v7
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: app/pyproject.toml
      - name: Install the pinned release
        run: python -m pip install ./app
      - name: Check required secrets without printing them
        shell: bash
        run: |
          test -n "$IBKR_FLEX_QUERY_ID"
          test -n "$IBKR_FLEX_TOKEN"
          if [[ "${{ github.event_name }}" != "workflow_dispatch" || "${{ inputs.no_push }}" != "true" ]]; then
            test -n "$ZECTRIX_API_KEY"
          fi
      - name: Fetch, render, and optionally push
        shell: bash
        run: |
          if [[ "${{ github.event_name }}" == "workflow_dispatch" && "${{ inputs.no_push }}" == "true" ]]; then
            ibkr-note4 run --no-push --output /tmp/ibkr-dashboard.png
          else
            ibkr-note4 run --no-dedupe --output /tmp/ibkr-dashboard.png
          fi
