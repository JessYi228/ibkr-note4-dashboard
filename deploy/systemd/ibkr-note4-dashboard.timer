[Unit]
Description=Refresh the T-1 IBKR NOTE4 dashboard on weekdays

[Timer]
# Activity Flex data is normally available through the previous business day.
# A non-round UTC minute also avoids common scheduler load spikes.
OnCalendar=Mon..Fri *-*-* 10:17:00 UTC
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
